# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: ollama | openai | anthropic
LLM_PROVIDER=ollama

# Ollama (local Qwen) — default
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI (Phase 3 optional)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Anthropic (Phase 3 optional)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── NCBI / PubMed ─────────────────────────────────────────────────────────────
# Optional — raises rate limit from 3 to 10 req/s
# Register free at: https://www.ncbi.nlm.nih.gov/account/
# NCBI_API_KEY=

# ── Embeddings (Phase 2) ──────────────────────────────────────────────────────
# Local model via Ollama — pull once with: ollama pull nomic-embed-text
EMBED_MODEL=nomic-embed-text

# ── Vector DB (Phase 2) ───────────────────────────────────────────────────────
CHROMA_PATH=../data/chroma

